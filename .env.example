# NEXORA – Production & Vercel Environment Configuration
# ========================================================

# Google Gemini Generative AI Configuration
# Get your API key from Google AI Studio: https://aistudio.google.com/
# On Vercel: Set this in Project Settings -> Environment Variables
GEMINI_API_KEY=

# Google Gemini Model (NEXORA uses Google's latest recommended model)
GEMINI_MODEL=gemini-3.8-flash

# Environment Mode ('production' on Vercel, 'development' locally)
NODE_ENV=production

# Server Port (used for local server and container environments)
PORT=5000

# Database Configuration
# - Locally: defaults to ./nexora.db
# - Vercel Serverless: automatically defaults to /tmp/nexora.db
DATABASE_FILE=

# Optional: Dedicated Backend URL (only needed if frontend and backend are hosted on separate domains)
# Leave empty when deploying fullstack to Vercel (same-origin /api)
VITE_API_URL=
