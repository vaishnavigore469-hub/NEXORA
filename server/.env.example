# NEXORA AI C++ Mock Interview Platform - Server Configuration

PORT=5000
NODE_ENV=development

# Google Gemini API Key
# Get your API key for free from: https://aistudio.google.com/
# Leave empty to run in built-in Demo Mode (which uses the local verified technical evaluation engine)
GEMINI_API_KEY=

# Gemini Model to use (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Database path (SQLite file stored locally)
DATABASE_FILE=./nexora.db
