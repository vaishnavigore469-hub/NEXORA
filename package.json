{
  "name": "nexora",
  "version": "1.0.0",
  "description": "NEXORA – Think. Answer. Evolve. AI-Powered C++ Mock Interview Platform",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "npm run build --prefix server && npm run build --prefix client",
    "build:client": "npm run build --prefix client",
    "build:server": "npm run build --prefix server",
    "start": "node server/dist/index.js",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "dev": "npm run dev --prefix server"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.9",
    "typescript": "^5.8.2"
  }
}
